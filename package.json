{
  "name": "cicd-software-architecture-demo",
  "version": "1.0.0",
  "description": "Demostración de CI/CD para el curso de Arquitectura de Software - Ingeniería de Sistemas",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "lint": "eslint src/ tests/ scripts/",
    "lint:fix": "eslint src/ tests/ scripts/ --fix",
    "demo:break": "node scripts/simulate-failure.js",
    "demo:fix": "node scripts/restore-tests.js",
    "demo:bump": "node scripts/bump-version.js"
  },
  "keywords": [
    "ci-cd",
    "software-architecture",
    "devops",
    "devsecops",
    "docker",
    "github-actions"
  ],
  "author": "Kevin, Pool, Zaga, Verton, Miriam, Pozo",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/public/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
